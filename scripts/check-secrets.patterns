# 级别	ERE正则	说明	(可选)第4列=grep flags，如 i
# —— BLOCK：命中即失败（真实密钥 / 明确隐私）——
BLOCK	sk-[A-Za-z0-9]{16,}	API key（OpenAI/DeepSeek 等 sk- 风格）
BLOCK	(ghp|gho|ghs|ghr)_[A-Za-z0-9]{36,}	GitHub token
BLOCK	github_pat_[A-Za-z0-9_]{60,}	GitHub fine-grained PAT
BLOCK	glpat-[A-Za-z0-9_-]{20,}	GitLab token
BLOCK	xox[baprs]-[A-Za-z0-9-]{10,}	Slack token
BLOCK	AKIA[0-9A-Z]{16}	AWS Access Key ID
BLOCK	-----BEGIN [A-Z ]*PRIVATE KEY-----	私钥文件内容
BLOCK	(auth[_-]?token|api[_-]?key|client[_-]?secret|access[_-]?token|passwd|password)["']?[[:space:]]*[:=][[:space:]]*["']?[A-Za-z0-9]{24,}	通用「键=长值」赋值	i
BLOCK	Bearer[[:space:]]+[A-Za-z0-9._~+/-]{20,}	HTTP Bearer 凭据	i
BLOCK	eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}	JWT
BLOCK	https?://[^/[:space:]:@]+:[^/[:space:]@]+@	URL 内嵌用户名密码
BLOCK	(z_c0|d_c0|__zse_ck)=	知乎 cookie 键名
BLOCK	vision-jam	本机 Linux 用户名
BLOCK	visionjam_vault	个人知识库路径名
BLOCK	[^0-9]29576[^0-9]	Windows 用户名（数字串）
BLOCK	DESKTOP-05N68KB	本机主机名
BLOCK	Ubuntu_Working	WSL 发行版名
BLOCK	[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}	邮箱地址
# —— WARN：需要人工复核 ——
WARN	[A-Fa-f0-9]{40,}	长十六进制串（可能是摘要/密钥）
WARN	[A-Za-z0-9+]{40,}={0,2}	长 base64 串（可能是密钥；不含 / 以免误报 URL）
WARN	[Cc]ookie[s]?[[:space:]]*[:=]	Cookie 赋值痕迹	i
WARN	[0-9]{1,3}(\.[0-9]{1,3}){3}	IP 地址（复核是否为公网固定 IP）
