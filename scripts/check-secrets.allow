# 白名单：对「命中的那段文本」做 ERE 匹配，整段匹配上则放行
# （只作用于命中片段，不是整行 —— 一行里其它部分照样会被其它规则检查）
^sk-REPLACE_ME$
^__[A-Z0-9_]+__$
^[A-Fa-f0-9]{64}$
^[A-Fa-f0-9]{40}$
^127\.0\.0\.1$
^0\.0\.0\.0$
^git@github\.com$
^[A-Za-z0-9._%+-]+@users\.noreply\.github\.com$
^[A-Za-z0-9._%+-]+@example\.(com|org|net)$
^[A-Za-z0-9._%+-]+@anthropic\.com$
^abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$
