#!/usr/bin/env bash
#
# nvm-link —— 把 nvm 当前 default 版本的入口链接进 ~/.local/bin
#
# 【要解决的问题】
#   nvm 只在 ~/.bashrc 里加载，而 ~/.bashrc 开头有「非交互就 return」的守卫。
#   于是「登录、但非交互」的 shell —— 桌面启动器、ssh 远程命令、IDE 的任务
#   运行器、`bash -l -c` —— 既没有 node，也没加载 nvm。
#   但这类 shell 会读 ~/.profile，而 ~/.profile 会把 ~/.local/bin 前置进 PATH。
#   所以把入口链接进 ~/.local/bin，正好补上这个缺口。
#
# 【为什么指向具体版本目录，而不是写个动态 wrapper】
#   wrapper 每次执行都得 source 一遍 nvm.sh（实测约 80ms）。node 会被频繁
#   调用（npm 脚本、构建工具链会嵌套调用几十次），固定开销不可接受。
#   符号链接是零开销的，代价是 nvm 换默认版本后要重跑本脚本。
#
# 【什么时候要重跑】
#   nvm install <新版本>      之后（如果它同时改了 default）
#   nvm alias default <版本>  之后
#   判断方法：node --version 跟 nvm current 对不上，就跑一下。
#
# 【不会影响什么】
#   交互式 shell 里 nvm 的 bin 目录排在 ~/.local/bin 前面，优先级不变；
#   两者最终指向同一个真实文件，所以不会出现「两个 node」打架。
#
set -uo pipefail

NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
BIN_DIR="$HOME/.local/bin"
# corepack 在新版本里可能不存在，缺了就跳过（下面的循环有 -e 检查）
COMMANDS=(node npm npx corepack)

if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    echo "nvm-link: 找不到 $NVM_DIR/nvm.sh" >&2
    exit 1
fi

# --no-use：只把 nvm 的函数加载进来，不自动切换本 shell 的 node 版本。
# 我们只需要 nvm which 这一个能力，不需要它改 PATH。
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh" --no-use

# nvm 的 default 是 'lts/*' 这类**间接**别名（lts/* → lts/krypton → v24.21.0），
# 所以必须让 nvm 自己解析——手写解析要处理两层跳转，很脆。
if ! NODE_BIN="$(nvm which default 2>/dev/null)"; then
    echo "nvm-link: nvm 的 default 版本不可用。先跑 'nvm install --lts'" >&2
    exit 1
fi

SRC_DIR="$(dirname "$NODE_BIN")"
VERSION="$(nvm version default)"

mkdir -p "$BIN_DIR"

linked=0
skipped=()
for cmd in "${COMMANDS[@]}"; do
    if [ ! -e "$SRC_DIR/$cmd" ]; then
        skipped+=("$cmd")
        continue
    fi
    # -s 建符号链接（覆盖旧的），-f 强制，-n 把已存在的**目录符号链接**当文件
    # 处理而不是钻进去建——少了 -n，重复执行会在里面套一层
    ln -sfn "$SRC_DIR/$cmd" "$BIN_DIR/$cmd"
    linked=$((linked + 1))
done

printf 'nvm-link: %s → %s（%d 个入口' "$VERSION" "$BIN_DIR" "$linked"
if [ ${#skipped[@]} -gt 0 ]; then
    printf '，跳过未提供的: %s' "${skipped[*]}"
fi
printf '）\n'
